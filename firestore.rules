// Firestore 보안 규칙 — Firebase 콘솔 > Firestore > 규칙 탭에 그대로 붙여넣고 [게시]
// 'REPLACE_WITH_ADMIN_UID'를 내 UID(Authentication > 사용자)로 바꾼다. js/config.js의 ADMIN_UID와 같아야 한다.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == '8ZccDm441mTb5zIdn32pVZxv3z92';
    }

    function validPost(d) {
      return d.keys().hasOnly(['title', 'date', 'content', 'categoryId', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['title', 'date', 'content', 'categoryId', 'createdAt', 'updatedAt'])
          && d.title is string   && d.title.trim().size() > 0   && d.title.size() <= 100
          && d.content is string && d.content.trim().size() > 0 && d.content.size() <= 20000
          && d.date is string    && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && (d.categoryId == null
              || (d.categoryId is string
                  && exists(/databases/$(database)/documents/categories/$(d.categoryId))))
          && d.updatedAt == request.time;
    }

    function validCategory(d) {
      return d.keys().hasOnly(['name', 'order', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['name', 'order', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.trim().size() > 0 && d.name.size() <= 20
          && d.name.trim() != '미분류'
          && d.order is int   && d.order >= 0 && d.order < 1000
          && d.updatedAt == request.time;
    }

    function validProfile(d) {
      return d.keys().hasOnly(['name', 'headline', 'avatarUrl', 'bio', 'skills',
                               'aiTools', 'aiInterests', 'links', 'showStats', 'updatedAt'])
          && d.keys().hasAll(['name', 'headline', 'avatarUrl', 'bio', 'skills',
                              'aiTools', 'aiInterests', 'links', 'showStats', 'updatedAt'])
          && d.name is string     && d.name.trim().size() > 0 && d.name.size() <= 30
          && d.headline is string && d.headline.size() <= 60
          && d.avatarUrl is string && d.avatarUrl.size() <= 500
          && (d.avatarUrl == '' || d.avatarUrl.matches('^https://.+'))
          && d.bio is string      && d.bio.size() <= 5000
          && d.skills is list      && d.skills.size() <= 20
          && d.aiTools is list     && d.aiTools.size() <= 10
          && d.aiInterests is list && d.aiInterests.size() <= 10
          && d.links is list       && d.links.size() <= 5
          && d.showStats is bool
          && d.updatedAt == request.time;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isAdmin()
                    && validPost(request.resource.data)
                    && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
                    && validPost(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin()
                    && validCategory(request.resource.data)
                    && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
                    && validCategory(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /profile/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && docId == 'main'
                            && validProfile(request.resource.data);
      allow delete: if false;
    }
    // 그 외 경로는 규칙이 없으므로 모두 거부됨
  }
}
